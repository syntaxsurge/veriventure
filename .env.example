# Public web config
NEXT_PUBLIC_POLKADOT_RPC_URL=ws://127.0.0.1:9944
NEXT_PUBLIC_BADGE_CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS
NEXT_PUBLIC_POLKADOT_NETWORK_NAME=Local ink! node
NEXT_PUBLIC_POLKADOT_GAS_REF_TIME=5000000000
NEXT_PUBLIC_POLKADOT_GAS_PROOF_SIZE=131072
NEXT_PUBLIC_CONVEX_URL=https://your-veriventure.convex.cloud

# Convex deployment helpers
CONVEX_DEPLOYMENT_URL=
CONVEX_RESET_TOKEN=
CONVEX_RESET_BATCH=128

# OpenAI (used for embeddings + copilots)
OPENAI_API_KEY=sk-your-key
OPENAI_COMPLETIONS_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Grokipedia live scrape fallback (optional)
GROKIPEDIA_BASE_URL=https://grokipedia.com
GROKIPEDIA_USER_AGENT=VeriVenture/1.0 (+https://veriventure.example)

# OriginTrail DKG Edge Node configuration
DKG_NODE_ENDPOINT=http://127.0.0.1
DKG_NODE_PORT=8900
DKG_NODE_API_VERSION=/v1
DKG_NODE_AUTH_TOKEN=
DKG_BLOCKCHAIN_NAME=hardhat1:31337
DKG_BLOCKCHAIN_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
DKG_MAX_RETRIES=180
DKG_POLL_FREQUENCY=2
