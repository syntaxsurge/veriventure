# Public web config
NEXT_PUBLIC_EVM_RPC_URL=https://rpc.api.moonbase.moonbeam.network
NEXT_PUBLIC_VALIDITY_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_EVM_NETWORK_NAME=Moonbase Alpha
NEXT_PUBLIC_EXPLORER_TX_TEMPLATE="https://polkadot.js.org/apps/#/explorer/query/{tx}"
NEXT_PUBLIC_DKG_VIEWER_TEMPLATE=https://origintrail.io/explorer/asset/{ual}

# Convex deployment helpers
CONVEX_RESET_TOKEN=
CONVEX_RESET_BATCH=128

# OpenAI (used for embeddings + copilots)
OPENAI_API_KEY=sk-000000000000000000000000000000000000000000000000
OPENAI_COMPLETIONS_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_IMAGE_MODEL=gpt-image-1
PITCH_DECK_IMAGE_SIZE=1792x1024
PITCH_DECK_SCRAPE_SIZE=1200x675

# Auth
AUTH_SECRET=replace-me-with-a-64-byte-random-secret-value-1234567890abcd

# Grokipedia live scrape fallback (optional)
GROKIPEDIA_BASE_URL=https://grokipedia.com
GROKIPEDIA_USER_AGENT=VeriVentureBot/1.0 (+https://veriventure.xyz)
WIKIPEDIA_USER_AGENT=VeriVentureBot/1.0 (+https://veriventure.xyz)

# OriginTrail DKG Edge Node configuration
DKG_NODE_ENDPOINT=http://127.0.0.1
DKG_NODE_PORT=8900
DKG_NODE_API_VERSION=/v1
DKG_NODE_AUTH_TOKEN=
DKG_BLOCKCHAIN_NAME=hardhat1:31337
DKG_BLOCKCHAIN_PRIVATE_KEY=
DKG_MAX_RETRIES=180
DKG_POLL_FREQUENCY=2
