{
  "name": "veriventure",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "format:code": "prettier --write \"**/*.{ts,tsx,js,jsx,cjs,mjs,cts,mts,json,css,scss,mdx,html}\"",
    "lint:all": "npm run lint:fix && npm run lint && npm run format:code",
    "typecheck": "tsc --noEmit",
    "build:contract": "cd blockchain && npm run compile",
    "convex:dev": "node ./scripts/convex-dev.cjs",
    "convex:deploy": "npx convex deploy -y",
    "convex:redeploy": "npm run convex:deploy && npm run convex:dev",
    "convex:reset": "dotenv -e .env -e .env.local -- tsx scripts/reset-convex.ts",
    "seed:demo": "dotenv -e .env -e .env.local -- tsx scripts/seed-demo.ts"
  },
